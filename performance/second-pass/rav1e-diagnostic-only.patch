+// Diagnostic-only RAII guards. Inclusive times overlap and must not be summed.
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+use std::time::Instant;
+static NS: [AtomicU64; 14] = [const { AtomicU64::new(0) }; 14];
+static CALLS: [AtomicU64; 14] = [const { AtomicU64::new(0) }; 14];
+pub(crate) struct Scope(usize, Instant);
+impl Scope { pub(crate) fn new(index: usize) -> Self { Self(index, Instant::now()) } }
+impl Drop for Scope {
+ fn drop(&mut self) { NS[self.0].fetch_add(self.1.elapsed().as_nanos() as u64, Relaxed); CALLS[self.0].fetch_add(1, Relaxed); }
+}
+pub(crate) fn report() {
+ eprintln!("rav1e dependency stages (inclusive)");
+ for (index, name) in ["tile", "intra_mode_rdo", "tx_size_type_rdo", "tx_type_rdo", "cfl_rdo", "distortion", "encode_tx_block", "loop_filter_queue", "prediction", "forward_transform", "quantization", "coefficient_entropy", "dequantization", "inverse_transform"].iter().enumerate() {
+  eprintln!("dep_stage {} calls={} ms={:.6}", name, CALLS[index].swap(0, Relaxed), NS[index].swap(0, Relaxed) as f64 / 1e6);
+ }
+}
